{
  "mcpServers": {
    "aseprite": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${ASEPRITE_MCP_DIR:-Aseprite/aseprite-mcp}",
        "-m",
        "aseprite_mcp"
      ],
      "env": {
        "PYTHONPATH": "${ASEPRITE_MCP_DIR:-Aseprite/aseprite-mcp}"
      }
    }
  }
}
